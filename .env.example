# Public browser configuration only. Supply reviewed values through secure setup.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only, owner-generated random signing secret (at least 32 characters).
# Required to bind verified password recovery to the reset form; never public.
NENSYNC_RECOVERY_SECRET=
# Optional server-only account deletion. Never expose as NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=
