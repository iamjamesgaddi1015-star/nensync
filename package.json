{
  "name": "nensync",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/run-next.mjs dev --hostname 127.0.0.1 --port 3210",
    "build": "node scripts/run-next.mjs build",
    "start": "node scripts/run-next.mjs start --hostname 127.0.0.1 --port 3210",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write src tests scripts supabase *.json *.mjs",
    "format:check": "prettier --check src tests scripts *.json *.mjs",
    "test": "tsx --test tests/domain.test.ts tests/database.test.ts",
    "test:e2e": "playwright test",
    "db:types": "tsx scripts/database-types.ts"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@electric-sql/pglite": "0.5.15",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "22.10.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.0",
    "eslint-config-next": "16.4.5",
    "node": "24.22.2",
    "prettier": "3.6.2",
    "tailwindcss": "4.3.4",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
